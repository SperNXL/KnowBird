<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_recognize"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#ffffff"
    android:padding="16dp"
    android:layout_margin="15dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最近识别"
            android:textSize="16sp"
            android:textColor="#212121" />

        <TextView
            android:id="@+id/tv_view_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:text="查看全部 >"
            android:textSize="14sp"
            android:textColor="#6C6C6C" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_all"
            style="@style/FilterButtonStyle"
            android:text="全部"
            android:background="@drawable/bg_filter_selected"
            android:textColor="@color/selected_color"/>

        <TextView
            android:id="@+id/btn_image"
            style="@style/FilterButtonStyle"
            android:text="图片"
            android:background="@drawable/bg_filter_unselected"
            android:textColor="@color/unselected_color"/>

        <TextView
            android:id="@+id/btn_audio"
            style="@style/FilterButtonStyle"
            android:text="声音"
            android:background="@drawable/bg_filter_unselected"
            android:textColor="@color/unselected_color"/>

        <TextView
            android:id="@+id/btn_unknown"
            style="@style/FilterButtonStyle"
            android:text="未识别"
            android:background="@drawable/bg_filter_unselected"
            android:textColor="@color/unselected_color"/>

    </LinearLayout>

</LinearLayout>
